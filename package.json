{
  "name": "codecraft",
  "version": "0.1.0",
  "description": "CodeCraft AI Coding IDE",
  "author": "CodeCraft",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "rebuild": "npx @electron/rebuild",
    "package": "npm run build && npx electron-builder"
  },
  "build": {
    "appId": "com.codecraft.ide",
    "productName": "CodeCraft",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "electron-download": "^4.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@anthropic-ai/sdk": "^1.6.0",
    "@monaco-editor/loader": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "keytar": "^7.9.0",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}