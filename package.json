{
  "name": "codecraft",
  "version": "0.1.0",
  "desktopName": "CodeCraft",
  "description": "CodeCraft AI Coding IDE",
  "author": {
    "name": "CodeCraft",
    "email": "hello@codecraft.dev"
  },
  "homepage": "https://github.com/vh9hvnwrg6-prog/code-craft",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "rebuild": "npx @electron/rebuild",
    "package": "npm run build && npx electron-builder",
    "dist:mac": "npm run build && npx electron-builder --mac",
    "dist:mac:intel": "npm run build && npx electron-builder --mac --x64",
    "dist:mac:arm": "npm run build && npx electron-builder --mac --arm64",
    "dist:linux": "npm run build && npx electron-builder --linux"
  },
  "build": {
    "appId": "com.codecraft.ide",
    "productName": "CodeCraft",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns"
    },
    "linux": {
      "category": "Development",
      "target": ["rpm", "AppImage", "deb"],
      "icon": "build/icon.iconset/icon_512x512.png",
      "syncDesktopName": true,
      "maintainer": "CodeCraft <hello@codecraft.dev>",
      "desktop": {
        "entry": {
          "Name": "CodeCraft",
          "Comment": "AI Coding IDE",
          "Categories": "Development;TextEditor",
          "Terminal": "true"
        }
      }
    },
    "rpm": {
      "depends": [
        "libX11",
        "libXext",
        "libXfixes",
        "libXi",
        "libXrender",
        "libGL",
        "libnss3",
        "libnspr4",
        "libdrm2",
        "libxkbcommon0",
        "libgbm1",
        "cups-libs",
        "gtk3"
      ]
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "electron-download": "^4.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@anthropic-ai/sdk": "^1.6.0",
    "@monaco-editor/loader": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.2.0-beta.18",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xterm": "^5.3.0"
  }
}
